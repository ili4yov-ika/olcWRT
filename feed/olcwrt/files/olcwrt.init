#!/bin/sh /etc/rc.common
# olcWRT: olcRTC client for OpenWrt

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/olcwrt

is_enabled() {
	local enabled
	config_load olcwrt
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ]
}

start_service() {
	if ! is_enabled; then
		"$PROG" cleanup >/dev/null 2>&1
		return 0
	fi

	procd_open_instance olcwrt
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	procd_set_param limits nofile="16384 16384"
	procd_close_instance
}

service_stopped() {
	# Only acts if the daemon died without removing its firewall rules.
	"$PROG" cleanup >/dev/null 2>&1
}

reload_service() {
	if ! is_enabled; then
		stop
		return 0
	fi
	"$PROG" reload >/dev/null 2>&1 || start
}

service_triggers() {
	procd_add_reload_trigger olcwrt
}
