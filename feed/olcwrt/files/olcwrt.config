
config main 'main'
	option enabled '0'
	option log_level 'info'
	option dns_server 'auto'
	option socks_port '8808'
	option redir_port '18809'
	option dns_port '18853'
	option lan_socks '0'
	option failover_retry '2s'
	option check_url 'http://cp.cloudflare.com/generate_204'

config routing 'routing'
	option mode 'all'
	list interface 'lan'
	option ipv6 '1'
	option block_quic '1'
	option dns_hijack '1'
	option source_mode 'all'

config dns 'dns'
	option enabled '1'
	option tunnel '1'
	list upstream '1.1.1.1:53'
	list upstream '8.8.8.8:53'
	option filter_aaaa '0'
	option set_timeout '12h'

